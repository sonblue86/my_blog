---
/**
 * Empty state for one library tab: themed inline illustration + friendly copy + ways forward.
 * Colours come from design tokens (classes below), so it is right in light and dark.
 */
import Icon from '../ui/Icon.astro';
import { CATEGORIES } from '../../config';

interface Props {
  kind: 'saved' | 'reading' | 'done';
}
const { kind } = Astro.props;
const uid = `le-${kind}`;

const copy = {
  saved: {
    title: 'Chưa có bài nào được lưu',
    text: 'Gặp bài hay mà chưa kịp đọc? Nhấn biểu tượng dấu trang để cất vào đây — đọc lúc nào cũng được, kể cả khi không có mạng.',
  },
  reading: {
    title: 'Bạn chưa đọc dở bài nào',
    text: 'Khi bạn đọc một bài, blog sẽ nhớ bạn dừng ở đâu để lần sau đọc tiếp đúng chỗ đó.',
  },
  done: {
    title: 'Kệ sách này còn trống',
    text: 'Đọc hết một bài, nó sẽ được xếp lên đây — một góc nhỏ ghi lại những gì bạn đã đọc.',
  },
}[kind];
---

<div class="lib-empty" data-empty={kind} hidden>
  {
    kind === 'saved' && (
      <svg class="lib-illo" viewBox="0 0 220 150" aria-hidden="true">
        <circle cx="110" cy="80" r="62" class="i-soft" />
        <rect x="56" y="46" width="94" height="74" rx="14" class="i-card i-back" transform="rotate(-9 103 83)" />
        <rect x="68" y="34" width="96" height="80" rx="14" class="i-card" />
        <rect x="82" y="58" width="52" height="8" rx="4" class="i-line" />
        <rect x="82" y="74" width="66" height="6" rx="3" class="i-line2" />
        <rect x="82" y="86" width="44" height="6" rx="3" class="i-line2" />
        <path d="M136 26h18v38l-9-7-9 7z" class="i-accent i-float" />
        <path d="M184 34l3 7.5 7.5 3-7.5 3-3 7.5-3-7.5-7.5-3 7.5-3z" class="i-hot i-twinkle" />
        <circle cx="40" cy="58" r="4" class="i-hot-soft" />
        <circle cx="178" cy="112" r="5" class="i-accent-soft" />
      </svg>
    )
  }
  {
    kind === 'reading' && (
      <svg class="lib-illo" viewBox="0 0 220 150" aria-hidden="true">
        <defs>
          <linearGradient id={`${uid}-g`} x1="0" x2="1" y1="0" y2="0">
            <stop offset="0" class="i-stop-a" />
            <stop offset="1" class="i-stop-b" />
          </linearGradient>
        </defs>
        <circle cx="110" cy="74" r="62" class="i-soft" />
        <path d="M110 48c-15-11-36-13-54-8v66c18-5 39-3 54 8z" class="i-card" />
        <path d="M110 48c15-11 36-13 54-8v66c-18-5-39-3-54 8z" class="i-card" />
        <path d="M68 60c11-2 22-1 32 3M68 72c11-2 22-1 32 3M68 84c11-2 22-1 24 1" class="i-stroke" />
        <path d="M120 63c10-3 21-4 32-2M120 75c10-3 21-4 32-2" class="i-stroke" />
        <path d="M140 42v40l7-6 7 6V40" class="i-accent i-float" />
        <rect x="58" y="128" width="104" height="8" rx="4" class="i-track" />
        <rect x="58" y="128" width="58" height="8" rx="4" fill={`url(#${uid}-g)`} class="i-grow" />
      </svg>
    )
  }
  {
    kind === 'done' && (
      <svg class="lib-illo" viewBox="0 0 220 150" aria-hidden="true">
        <circle cx="110" cy="76" r="62" class="i-soft" />
        <rect x="64" y="58" width="18" height="56" rx="4" class="i-book i-b1" />
        <rect x="85" y="46" width="16" height="68" rx="4" class="i-book i-b2" />
        <rect x="104" y="64" width="20" height="50" rx="4" class="i-book i-b3" />
        <rect x="128" y="60" width="16" height="54" rx="4" class="i-book i-b4" transform="rotate(14 136 114)" />
        <rect x="52" y="114" width="116" height="7" rx="3.5" class="i-shelf" />
        <circle cx="160" cy="46" r="17" class="i-ok i-float" />
        <path d="M152.5 46.5l5.2 5.2 9.3-10.2" class="i-check i-float" />
        <path d="M46 40l2.5 6 6 2.5-6 2.5-2.5 6-2.5-6-6-2.5 6-2.5z" class="i-hot i-twinkle" />
      </svg>
    )
  }

  <h2 class="lib-empty-title">{copy.title}</h2>
  <p class="lib-empty-text">{copy.text}</p>

  <div class="lib-empty-actions">
    {
      kind === 'saved' ? (
        <>
          <a href="/" class="btn btn-primary">
            <Icon name="sparkles" size={18} />
            Khám phá bài mới
          </a>
          <button type="button" class="btn btn-ghost" data-open-search>
            <Icon name="search" size={18} />
            Tìm bài viết
          </button>
        </>
      ) : (
        <>
          <a href="/" class="btn btn-primary">
            <Icon name="book-open" size={18} />
            Chọn một bài để đọc
          </a>
          <a href="/ngau-nhien/" class="btn btn-ghost">
            <Icon name="dice" size={18} />
            Đọc ngẫu nhiên
          </a>
        </>
      )
    }
  </div>
  <div class="lib-empty-cats" aria-label="Chuyên mục">
    {
      CATEGORIES.map((c) => (
        <a href={`/chuyen-muc/${c.id}/`} class="chip" style={`--chip-color:${c.color}`}>
          <span aria-hidden="true">{c.icon}</span> {c.name}
        </a>
      ))
    }
  </div>
  {kind === 'saved' && <p class="lib-empty-tip">Mẹo: khi đang đọc trên máy tính, nhấn phím <kbd class="kbd">B</kbd> để lưu nhanh.</p>}
</div>

<style>
  .lib-empty {
    display: grid;
    justify-items: center;
    padding: 28px 8px 36px;
    text-align: center;
  }
  .lib-illo {
    width: min(240px, 72vw);
    height: auto;
    margin-bottom: 18px;
    overflow: visible;
  }
  .lib-empty-title {
    font-size: clamp(1.35rem, 1.1rem + 1vw, 1.6rem);
    font-weight: 800;
    line-height: 1.2;
  }
  .lib-empty-text {
    max-width: 46ch;
    margin-top: 10px;
    color: var(--fg-muted);
    line-height: 1.65;
  }
  .lib-empty-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 22px;
  }
  .lib-empty-cats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-top: 16px;
  }
  .lib-empty-cats .chip {
    height: 36px;
    padding: 0 14px;
  }
  .lib-empty-tip {
    margin-top: 20px;
    font-size: 0.85rem;
    color: var(--fg-subtle);
  }
  @media (pointer: coarse) {
    .lib-empty-tip {
      display: none;
    }
  }

  /* Illustration palette — tokens only */
  .i-soft {
    fill: var(--accent-soft);
  }
  .i-card {
    fill: var(--bg-elevated);
    stroke: var(--border-strong);
    stroke-width: 1.5;
  }
  .i-back {
    fill: var(--bg-subtle);
  }
  .i-line {
    fill: var(--fg-subtle);
    opacity: 0.55;
  }
  .i-line2 {
    fill: var(--border-strong);
  }
  .i-stroke {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 3;
    stroke-linecap: round;
  }
  .i-accent {
    fill: var(--accent);
  }
  .i-accent-soft {
    fill: color-mix(in oklab, var(--accent) 35%, transparent);
  }
  .i-hot {
    fill: var(--hot);
  }
  .i-hot-soft {
    fill: color-mix(in oklab, var(--hot) 45%, transparent);
  }
  .i-track {
    fill: var(--bg-muted);
  }
  .i-stop-a {
    stop-color: var(--accent);
  }
  .i-stop-b {
    stop-color: var(--hot);
  }
  .i-book {
    stroke: color-mix(in oklab, var(--fg) 12%, transparent);
    stroke-width: 1;
  }
  .i-b1 {
    fill: var(--cat-ai);
  }
  .i-b2 {
    fill: var(--cat-tech);
  }
  .i-b3 {
    fill: var(--cat-life);
  }
  .i-b4 {
    fill: var(--accent);
  }
  .i-shelf {
    fill: var(--fg-subtle);
    opacity: 0.7;
  }
  .i-ok {
    fill: var(--success);
  }
  .i-check {
    fill: none;
    stroke: var(--bg-elevated);
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (prefers-reduced-motion: no-preference) {
    .i-float {
      animation: i-float 3.6s ease-in-out infinite;
    }
    .i-twinkle {
      transform-box: fill-box;
      transform-origin: center;
      animation: i-twinkle 2.8s ease-in-out infinite;
    }
    .i-grow {
      transform-box: fill-box;
      transform-origin: left center;
      animation: i-grow 2.4s var(--ease-out) both;
    }
  }
  @keyframes i-float {
    50% {
      transform: translateY(-4px);
    }
  }
  @keyframes i-twinkle {
    50% {
      transform: scale(0.6) rotate(20deg);
      opacity: 0.6;
    }
  }
  @keyframes i-grow {
    from {
      transform: scaleX(0.15);
    }
  }
</style>
