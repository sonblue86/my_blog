---
/**
 * Ảnh có chú thích.
 *   import anh from './anh.jpg';
 *   <Figure src={anh} alt="Mô tả ảnh" caption="Chú thích hiện dưới ảnh" wide />
 * `src` có thể là ảnh import (được astro:assets tối ưu) hoặc chuỗi URL ("/images/a.png", "https://…").
 * SVG import được giữ nguyên dạng vector.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  /** Mô tả ảnh cho người dùng trình đọc màn hình. Ảnh trang trí: alt="". */
  alt: string;
  caption?: string;
  /** Tràn rộng hơn cột chữ trên màn hình lớn. */
  wide?: boolean;
  /** Kích thước gốc — nên khai báo khi src là chuỗi để tránh nhảy layout. */
  width?: number;
  height?: number;
  /** Nguồn ảnh / tác giả, hiện nhỏ sau chú thích. */
  credit?: string;
  /** Ảnh đầu bài: tải ngay thay vì lazy. */
  eager?: boolean;
}

const { src, alt, caption, wide = false, width, height, credit, eager = false } = Astro.props;
const hasSlot = Astro.slots.has('default');
const loading = eager ? 'eager' : 'lazy';
const sizes = wide
  ? '(min-width: 1024px) 860px, 100vw'
  : '(min-width: 768px) 720px, 100vw';

// SVG imports are components carrying image metadata; serve the vector file as-is.
const meta = typeof src === 'string' ? null : (src as ImageMetadata);
const isVector = !!meta && meta.format === 'svg';
---

<figure class:list={['mdx-figure', { wide }]}>
  {
    typeof src === 'string' ? (
      <img src={src} alt={alt} width={width} height={height} loading={loading} decoding="async" />
    ) : isVector ? (
      <img src={meta!.src} alt={alt} width={meta!.width} height={meta!.height} loading={loading} decoding="async" />
    ) : (
      <Image
        src={src}
        alt={alt}
        widths={[480, 720, 960, 1440]}
        sizes={sizes}
        loading={loading}
        decoding="async"
      />
    )
  }
  {
    (caption || hasSlot || credit) && (
      <figcaption>
        {caption}
        <slot />
        {credit && <span class="mdx-figure-credit">{credit}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  .mdx-figure {
    margin-block: 2em;
  }
  .mdx-figure img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    background: var(--bg-subtle);
  }
  .mdx-figure figcaption {
    margin-top: 0.75em;
    text-align: center;
    font-family: var(--font-sans);
    font-size: 0.85em;
    line-height: 1.55;
    color: var(--fg-subtle);
    text-wrap: balance;
  }
  .mdx-figure-credit {
    display: block;
    margin-top: 0.2em;
    font-size: 0.92em;
    opacity: 0.85;
  }
</style>
