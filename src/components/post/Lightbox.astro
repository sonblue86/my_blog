---
/** Tap/click an article image to view it full screen (zoom-from-origin animation, Esc/click/swipe to close, ←/→ between images). */
import Icon from '../ui/Icon.astro';
---

<dialog class="lightbox" id="lightbox" aria-label="Xem ảnh">
  <figure class="lb-figure">
    <img class="lb-img" alt="" />
    <figcaption class="lb-caption"></figcaption>
  </figure>
  <button type="button" class="lb-close btn-icon" aria-label="Đóng ảnh"><Icon name="x" /></button>
  <button type="button" class="lb-nav lb-prev btn-icon" aria-label="Ảnh trước"><Icon name="chevron-left" /></button>
  <button type="button" class="lb-nav lb-next btn-icon" aria-label="Ảnh sau"><Icon name="chevron-right" /></button>
</dialog>

<style>
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: #fff;
  }
  .lightbox::backdrop {
    background: rgb(8 8 12 / 0.92);
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
  }
  .lb-figure {
    display: grid;
    gap: 12px;
    justify-items: center;
    max-width: 94vw;
  }
  .lb-img {
    max-width: 94vw;
    max-height: 84dvh;
    object-fit: contain;
    border-radius: 10px;
    touch-action: pinch-zoom;
  }
  .lb-caption {
    max-width: 70ch;
    font-size: 0.9rem;
    text-align: center;
    color: rgb(255 255 255 / 0.8);
  }
  .lightbox .btn-icon {
    position: absolute;
    color: #fff;
    background: rgb(255 255 255 / 0.1);
  }
  .lightbox .btn-icon:hover {
    background: rgb(255 255 255 / 0.2);
  }
  .lb-close {
    top: calc(12px + env(safe-area-inset-top));
    right: 12px;
  }
  .lb-nav {
    top: 50%;
    translate: 0 -50%;
  }
  .lb-prev {
    left: 12px;
  }
  .lb-next {
    right: 12px;
  }
  :global(#post-body img:not(a img)) {
    cursor: zoom-in;
  }
</style>

<script>
  const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
  const imgs = [...document.querySelectorAll<HTMLImageElement>('#post-body img')].filter((i) => !i.closest('a'));
  if (dlg && imgs.length) {
    const view = dlg.querySelector<HTMLImageElement>('.lb-img')!;
    const cap = dlg.querySelector<HTMLElement>('.lb-caption')!;
    const navs = dlg.querySelectorAll<HTMLElement>('.lb-nav');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = 0;

    const show = (i: number, from?: DOMRect) => {
      index = (i + imgs.length) % imgs.length;
      const src = imgs[index];
      view.src = src.currentSrc || src.src;
      view.alt = src.alt;
      cap.textContent = src.closest('figure')?.querySelector('figcaption')?.textContent || src.alt || '';
      navs.forEach((n) => (n.hidden = imgs.length < 2));
      if (from && !reduce) {
        // Zoom from the thumbnail's position (FLIP).
        requestAnimationFrame(() => {
          const to = view.getBoundingClientRect();
          if (!to.width) return;
          const dx = from.left + from.width / 2 - (to.left + to.width / 2);
          const dy = from.top + from.height / 2 - (to.top + to.height / 2);
          const s = from.width / to.width;
          view.animate(
            [{ transform: `translate(${dx}px, ${dy}px) scale(${s})`, opacity: 0.6 }, { transform: 'none', opacity: 1 }],
            { duration: 320, easing: 'cubic-bezier(.2,.8,.2,1)' },
          );
        });
      }
    };

    imgs.forEach((img, i) =>
      img.addEventListener('click', () => {
        dlg.showModal();
        show(i, img.getBoundingClientRect());
      }),
    );
    dlg.querySelector('.lb-close')!.addEventListener('click', () => dlg.close());
    dlg.querySelector('.lb-prev')!.addEventListener('click', () => show(index - 1));
    dlg.querySelector('.lb-next')!.addEventListener('click', () => show(index + 1));
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg || e.target === dlg.querySelector('.lb-figure')) dlg.close();
    });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    let sx = 0;
    let sy = 0;
    dlg.addEventListener('touchstart', (e) => ((sx = e.touches[0].clientX), (sy = e.touches[0].clientY)), { passive: true });
    dlg.addEventListener(
      'touchend',
      (e) => {
        if (e.touches.length) return;
        const dx = e.changedTouches[0].clientX - sx;
        const dy = e.changedTouches[0].clientY - sy;
        if (Math.abs(dy) > 90 && Math.abs(dy) > Math.abs(dx)) dlg.close();
        else if (Math.abs(dx) > 70 && imgs.length > 1) show(index + (dx < 0 ? 1 : -1));
      },
      { passive: true },
    );
  }
</script>
