---
/**
 * Select ≥ 3 words in the article (not in code) → a small floating toolbar: copy a quote (with a link that jumps
 * to and highlights the passage via a text fragment), share on X / Facebook, or copy the link to the passage.
 * Above the selection with a mouse; below it on touch (the OS selection menu lives above).
 * Keyboard: after selecting with Shift+arrows press Tab to enter the toolbar, ←/→ to move, Esc to dismiss.
 */
import Icon from '../ui/Icon.astro';
---

<div class="ss" data-selection-share role="toolbar" aria-label="Chia sẻ đoạn đã chọn" data-place="above" hidden>
  <button type="button" class="ss-btn ss-main" data-ss-action="quote" aria-label="Sao chép trích dẫn" data-tip="Sao chép trích dẫn">
    <Icon name="quote" size={16} />
    <span>Trích dẫn</span>
  </button>
  <span class="ss-sep" aria-hidden="true"></span>
  <button type="button" class="ss-btn" data-ss-action="x" aria-label="Chia sẻ lên X" data-tip="Chia sẻ X" tabindex="-1">
    <Icon name="brand-x" size={16} />
  </button>
  <button type="button" class="ss-btn" data-ss-action="facebook" aria-label="Chia sẻ lên Facebook" data-tip="Chia sẻ Facebook" tabindex="-1">
    <Icon name="brand-facebook" size={17} />
  </button>
  <button type="button" class="ss-btn" data-ss-action="link" aria-label="Sao chép liên kết tới đoạn này" data-tip="Sao chép liên kết tới đoạn này" tabindex="-1">
    <Icon name="link" size={17} />
  </button>
  <span class="ss-arrow" aria-hidden="true"></span>
</div>
<p class="ss-live" data-ss-live aria-live="polite"></p>

<style>
  .ss {
    --x: 0px;
    --y: 0px;
    --arrow-x: 50%;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    border-radius: 14px;
    background: var(--fg);
    color: var(--bg);
    box-shadow: var(--shadow-lg);
    translate: var(--x) var(--y);
    -webkit-user-select: none;
    user-select: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ss:not([hidden]) {
      animation: ss-in 160ms var(--ease-out);
    }
  }
  @keyframes ss-in {
    from {
      opacity: 0;
      transform: translateY(4px) scale(0.96);
    }
  }
  .ss[data-place='below'] {
    animation-name: ss-in-below;
  }
  @keyframes ss-in-below {
    from {
      opacity: 0;
      transform: translateY(-4px) scale(0.96);
    }
  }
  .ss-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-width: 44px;
    height: 44px;
    padding: 0 10px;
    border-radius: 10px;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    color: inherit;
    opacity: 0.86;
    transition:
      background-color 120ms var(--ease-out),
      opacity 120ms var(--ease-out);
  }
  .ss-main {
    padding: 0 12px 0 10px;
    opacity: 1;
  }
  .ss-btn:hover,
  .ss-btn:focus-visible {
    opacity: 1;
    background: color-mix(in oklab, var(--bg) 16%, transparent);
  }
  .ss-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .ss-btn:active {
    background: color-mix(in oklab, var(--bg) 24%, transparent);
  }
  .ss-sep {
    width: 1px;
    height: 22px;
    margin: 0 2px;
    background: color-mix(in oklab, var(--bg) 24%, transparent);
  }
  .ss-arrow {
    position: absolute;
    left: var(--arrow-x);
    width: 12px;
    height: 12px;
    margin-left: -6px;
    background: inherit;
    rotate: 45deg;
    border-radius: 2px;
  }
  .ss[data-place='above'] .ss-arrow {
    bottom: -5px;
  }
  .ss[data-place='below'] .ss-arrow {
    top: -5px;
  }
  /* Desktop tooltips (labels are also exposed via aria-label, so nothing depends on hover). */
  @media (hover: hover) and (pointer: fine) {
    .ss-btn:not(.ss-main)::after {
      content: attr(data-tip);
      position: absolute;
      left: 50%;
      bottom: calc(100% + 12px);
      padding: 5px 9px;
      border-radius: 8px;
      background: var(--bg-elevated);
      color: var(--fg);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      font-size: 0.75rem;
      font-weight: 600;
      opacity: 0;
      pointer-events: none;
      translate: -50% 4px;
      transition:
        opacity 120ms var(--ease-out),
        translate 120ms var(--ease-out);
    }
    .ss[data-place='below'] .ss-btn:not(.ss-main)::after {
      bottom: auto;
      top: calc(100% + 12px);
      translate: -50% -4px;
    }
    .ss-btn:not(.ss-main):is(:hover, :focus-visible)::after {
      opacity: 1;
      translate: -50% 0;
    }
  }
  .ss-live {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<style is:global>
  /* Passage opened from a shared "#:~:text=" link. */
  ::target-text {
    background-color: color-mix(in oklab, var(--accent) 26%, transparent);
    color: var(--fg);
  }
</style>

<script>
  import { readSelection, type SelectionInfo } from '../../scripts/selection-share';
  import { withTextFragment, truncateQuote } from '../../scripts/text-fragment';
  import { copyText, toast, absoluteUrl } from '../../scripts/share';

  const bar = document.querySelector<HTMLElement>('[data-selection-share]');
  const body = document.getElementById('post-body');
  const live = document.querySelector<HTMLElement>('[data-ss-live]');
  const article = document.querySelector<HTMLElement>('article.post');

  if (bar && body && !bar.dataset.wired) {
    bar.dataset.wired = '';
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('.ss-btn')];
    const title = article?.dataset.postTitle || document.title;
    const pageUrl = () => absoluteUrl(article?.dataset.postUrl || location.pathname);
    const coarse = () => matchMedia('(pointer: coarse)').matches;
    let info: SelectionInfo | null = null;
    let pointerDown = false;
    let viaKeyboard = false;
    let timer = 0;
    let announced = false;
    let returnTo: HTMLElement | null = null;

    // ---------- show / hide ----------
    function hide() {
      clearTimeout(timer);
      if (bar!.hidden) return;
      const hadFocus = bar!.contains(document.activeElement);
      bar!.hidden = true;
      info = null;
      buttons.forEach((b, k) => (b.tabIndex = k === 0 ? 0 : -1));
      if (hadFocus) {
        if (returnTo?.isConnected && returnTo !== document.body) returnTo.focus({ preventScroll: true });
        else (document.activeElement as HTMLElement | null)?.blur();
      }
      returnTo = null;
    }

    function place(range: Range) {
      const rects = [...range.getClientRects()].filter((r) => r.width > 0 && r.height > 0);
      if (!rects.length) return false;
      const first = rects[0];
      const last = rects[rects.length - 1];
      const all = range.getBoundingClientRect();
      bar!.hidden = false;
      const w = bar!.offsetWidth;
      const h = bar!.offsetHeight;
      const gap = 10;
      // Touch: below the selection (the OS menu + handles sit above / at the ends). Mouse: above it.
      let below = coarse();
      let top = below ? last.bottom + gap + 18 : first.top - h - gap;
      if (!below && top < 8) {
        below = true;
        top = last.bottom + gap;
      } else if (below && top + h > innerHeight - 8) {
        below = false;
        top = first.top - h - gap - 18;
      }
      if (top < 8 || top + h > innerHeight - 8) return false; // selection scrolled out of view
      const anchor = below ? last : first;
      const cx = rects.length > 1 ? (below ? anchor.left + anchor.width / 2 : all.left + all.width / 2) : anchor.left + anchor.width / 2;
      const left = Math.min(Math.max(8, cx - w / 2), innerWidth - w - 8);
      bar!.dataset.place = below ? 'below' : 'above';
      bar!.style.setProperty('--x', `${Math.round(left)}px`);
      bar!.style.setProperty('--y', `${Math.round(top)}px`);
      bar!.style.setProperty('--arrow-x', `${Math.round(Math.min(Math.max(16, cx - left), w - 16))}px`);
      return true;
    }

    function check() {
      if (pointerDown) return;
      const next = readSelection(body!, getSelection());
      if (!next) return hide();
      info = next;
      if (!place(next.range)) return hide();
      if (viaKeyboard && !announced && live) {
        announced = true;
        live.textContent = 'Đã chọn đoạn văn. Nhấn Tab để sao chép trích dẫn hoặc chia sẻ.';
      }
    }

    // ---------- selection tracking ----------
    document.addEventListener('pointerdown', (e) => {
      if (bar.contains(e.target as Node)) return;
      pointerDown = e.pointerType === 'mouse';
      viaKeyboard = false;
      hide();
    });
    document.addEventListener('pointerup', (e) => {
      if (e.pointerType !== 'mouse' || !pointerDown) return;
      pointerDown = false;
      clearTimeout(timer);
      timer = window.setTimeout(check, 10);
    });
    document.addEventListener('selectionchange', () => {
      if (pointerDown) return; // mouse drag in progress → wait for pointerup
      const sel = getSelection();
      if (!sel || sel.isCollapsed) {
        if (!bar.contains(document.activeElement)) hide();
        return;
      }
      clearTimeout(timer);
      // Touch handles and Shift+arrows fire many events — settle first.
      timer = window.setTimeout(check, coarse() ? 400 : 250);
    });
    document.addEventListener('keydown', (e) => {
      if (e.shiftKey && e.key.startsWith('Arrow')) viaKeyboard = true;
    });
    addEventListener('scroll', hide, { passive: true });
    addEventListener('resize', hide);

    // Keep the page selection when pressing a toolbar button.
    bar.addEventListener('pointerdown', (e) => e.preventDefault());

    // ---------- keyboard ----------
    // Capture phase on window so Esc here doesn't also exit focus mode etc.
    addEventListener(
      'keydown',
      (e) => {
        if (bar.hidden) return;
        const inBar = bar.contains(document.activeElement);
        if (e.key === 'Escape') {
          e.preventDefault();
          e.stopPropagation();
          hide();
          return;
        }
        if (e.key === 'Tab' && !e.shiftKey && !inBar && !e.altKey && !e.ctrlKey && !e.metaKey) {
          e.preventDefault();
          returnTo = document.activeElement as HTMLElement | null;
          buttons[0].focus();
          return;
        }
        if (!inBar) return;
        const i = buttons.indexOf(document.activeElement as HTMLButtonElement);
        let j = -1;
        if (e.key === 'ArrowRight') j = (i + 1) % buttons.length;
        else if (e.key === 'ArrowLeft') j = (i - 1 + buttons.length) % buttons.length;
        else if (e.key === 'Home') j = 0;
        else if (e.key === 'End') j = buttons.length - 1;
        else if (e.key === 'Tab') {
          hide(); // leaving the toolbar
          return;
        }
        if (j >= 0) {
          e.preventDefault();
          buttons.forEach((b, k) => (b.tabIndex = k === j ? 0 : -1));
          buttons[j].focus();
        }
      },
      true,
    );

    // ---------- actions ----------
    bar.addEventListener('click', async (e) => {
      const btn = (e.target as Element).closest<HTMLButtonElement>('[data-ss-action]');
      if (!btn || !info) return;
      const url = withTextFragment(pageUrl(), info.hash);
      const quote = info.quote;
      const action = btn.dataset.ssAction;
      hide();
      const enc = encodeURIComponent;
      if (action === 'quote') {
        const ok = await copyText(`“${quote}”\n— ${title}\n${url}`);
        toast(ok ? 'Đã sao chép trích dẫn kèm liên kết' : 'Không sao chép được, bạn thử lại nhé', { tone: ok ? 'ok' : 'error' });
      } else if (action === 'link') {
        const ok = await copyText(url);
        toast(ok ? 'Đã sao chép liên kết tới đoạn này' : 'Không sao chép được, bạn thử lại nhé', { tone: ok ? 'ok' : 'error' });
      } else if (action === 'x') {
        // 280 chars total; the URL always counts as 23.
        const room = Math.max(60, 280 - 23 - title.length - 8);
        const text = `“${truncateQuote(quote.replace(/\n/g, ' '), room)}” — ${title}`;
        window.open(`https://x.com/intent/post?text=${enc(text)}&url=${enc(url)}`, '_blank', 'noopener,noreferrer,width=600,height=560');
      } else if (action === 'facebook') {
        window.open(
          `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}&quote=${enc(truncateQuote(quote, 500))}`,
          '_blank',
          'noopener,noreferrer,width=640,height=600',
        );
      }
    });
  }
</script>
