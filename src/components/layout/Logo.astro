---
import { SITE } from '../../config';
import { markInner } from '../../lib/brand-mark.mjs';
interface Props {
  class?: string;
  /** Hide the wordmark below this breakpoint (mark only). */
  compact?: boolean;
}
const { class: className = '', compact = false } = Astro.props;
// Unique gradient id per instance (the logo appears twice on a page: header + mobile menu).
const g = globalThis as { __nsLogoCount?: number };
const gid = `logo-g-${(g.__nsLogoCount = (g.__nsLogoCount ?? 0) + 1)}`;
---

<a href="/" class:list={['logo group inline-flex items-center gap-2.5 rounded-xl', className]} aria-label={`${SITE.title} — Trang chủ`}>
  <svg class="logo-mark" width="34" height="34" viewBox="0 0 34 34" aria-hidden="true" set:html={markInner({ id: gid, classes: true })} />
  <span class:list={['logo-word font-display text-[1.2rem] font-extrabold tracking-tight text-fg', compact && 'max-sm:hidden']}>
    {SITE.title}<span class="logo-qm" aria-hidden="true">?</span>
  </span>
</a>

<style>
  .logo-mark {
    flex-shrink: 0;
  }
  /* The "?" after the wordmark is decoration only — the site name itself has no question mark. */
  .logo-qm {
    margin-left: 0.04em;
    color: var(--hot);
  }
  .logo :global(.logo-bubble) {
    transform-box: fill-box;
    transform-origin: 12% 100%; /* the tail */
  }
  .logo :global(.logo-q) {
    transform-box: fill-box;
    transform-origin: 50% 100%; /* the dot */
  }
  /* Hover: the bubble pops and the question mark tilts its head — "gì thế nhỉ?" */
  @media (prefers-reduced-motion: no-preference) {
    .logo:hover :global(.logo-bubble) {
      animation: logo-pop 520ms var(--ease-out);
    }
    .logo:hover :global(.logo-q) {
      animation: logo-tilt 760ms var(--ease-out);
    }
  }
  @keyframes logo-pop {
    40% {
      transform: scale(1.06);
    }
  }
  @keyframes logo-tilt {
    30% {
      transform: rotate(-14deg);
    }
    65% {
      transform: rotate(8deg);
    }
  }
</style>
