---
import { SITE } from '../../config';
interface Props {
  class?: string;
  /** Hide the wordmark below this breakpoint (mark only). */
  compact?: boolean;
}
const { class: className = '', compact = false } = Astro.props;
// Unique gradient id per instance (the logo appears twice on a page: header + mobile menu).
const g = globalThis as { __nsLogoCount?: number };
const gid = `logo-g-${(g.__nsLogoCount = (g.__nsLogoCount ?? 0) + 1)}`;
---

<a href="/" class:list={['logo group inline-flex items-center gap-2.5 rounded-xl', className]} aria-label={`${SITE.title} — Trang chủ`}>
  <svg class="logo-mark" width="34" height="34" viewBox="0 0 34 34" aria-hidden="true">
    <defs>
      <linearGradient id={gid} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#6d5dfc"></stop>
        <stop offset="1" stop-color="#f0562e"></stop>
      </linearGradient>
    </defs>
    <rect width="34" height="34" rx="10" fill={`url(#${gid})`}></rect>
    <path
      class="logo-pulse"
      d="M6 18.5h5.2l2.6-6.5 4.4 11 3.1-8 1.9 3.5H28"
      fill="none"
      stroke="#fff"
      stroke-width="2.6"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  <span class:list={['logo-word font-display text-[1.2rem] font-extrabold tracking-tight text-fg', compact && 'max-sm:hidden']}>
    {SITE.title}
  </span>
</a>

<style>
  .logo-pulse {
    stroke-dasharray: 48;
    stroke-dashoffset: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .logo:hover .logo-pulse {
      animation: pulse-draw 900ms var(--ease-out);
    }
  }
  @keyframes pulse-draw {
    from {
      stroke-dashoffset: 48;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
