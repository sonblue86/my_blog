---
import { SITE, CATEGORIES, SOCIAL } from '../../config';
import Icon from '../ui/Icon.astro';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer mt-24 border-t border-border bg-subtle/60">
  <div class="container-page py-14">
    <div class="grid gap-12 lg:grid-cols-[1.2fr_1fr]">
      <div class="max-w-md">
        <Logo />
        <p class="mt-4 text-fg-muted">{SITE.description}</p>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
        <div>
          <p class="eyebrow mb-3">Chuyên mục</p>
          <ul class="footer-links">
            {
              CATEGORIES.map((c) => (
                <li>
                  <a href={`/chuyen-muc/${c.id}/`}>{c.name}</a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="eyebrow mb-3">Khám phá</p>
          <ul class="footer-links">
            <li><a href="/luu-tru/">Lưu trữ</a></li>
            <li><a href="/the/">Thẻ</a></li>
            <li><a href="/thu-vien/">Thư viện của bạn</a></li>
            <li><a href="/ngau-nhien/" data-random-post>Đọc ngẫu nhiên</a></li>
          </ul>
        </div>
        <div>
          <p class="eyebrow mb-3">Blog</p>
          <ul class="footer-links">
            <li><a href="/gioi-thieu/">Giới thiệu</a></li>
            <li><a href="/rss.xml">RSS</a></li>
            <li><a href="/sitemap-index.xml">Sitemap</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-14 flex flex-col-reverse gap-6 border-t border-border pt-6 text-sm text-fg-subtle sm:flex-row sm:items-center sm:justify-between">
      <p>
        © {year}
        {SITE.title} · Dev with love <span class="text-hot" aria-hidden="true">♥</span>
        <span class="hidden lg:inline"> · Nhấn <kbd class="kbd">?</kbd> để xem phím tắt.</span>
      </p>
      <div class="-ml-3 flex items-center gap-1 sm:ml-0">
        <a class="btn-icon" href="/rss.xml" aria-label="RSS"><Icon name="rss" size={18} /></a>
        {SOCIAL.github && <a class="btn-icon" href={SOCIAL.github} aria-label="GitHub" rel="me noopener" target="_blank"><Icon name="brand-github" size={18} /></a>}
        {SOCIAL.facebook && <a class="btn-icon" href={SOCIAL.facebook} aria-label="Facebook" rel="me noopener" target="_blank"><Icon name="brand-facebook" size={18} /></a>}
        {SOCIAL.youtube && <a class="btn-icon" href={SOCIAL.youtube} aria-label="YouTube" rel="me noopener" target="_blank"><Icon name="brand-youtube" size={18} /></a>}
        {SOCIAL.x && <a class="btn-icon" href={SOCIAL.x} aria-label="X" rel="me noopener" target="_blank"><Icon name="brand-x" size={18} /></a>}
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-links {
    display: grid;
    gap: 2px;
  }
  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--fg-muted);
    transition: color 150ms var(--ease-out);
  }
  .footer-links a:hover {
    color: var(--fg);
  }
  .site-footer {
    padding-bottom: env(safe-area-inset-bottom);
  }
</style>
