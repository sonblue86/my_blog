---
/**
 * Newsletter sign-up. Posts to /api/subscribe (Cloudflare Worker + D1, see worker/ and docs/CLOUDFLARE.md).
 * Contract: POST JSON { email, website, token?, source? } -> { ok: true, status: 'subscribed' | 'exists' } | { ok: false, error }
 * `website` is a honeypot field that humans never see.
 * Optional Cloudflare Turnstile (src/config.ts → TURNSTILE.siteKey): its script loads only when the reader
 * first focuses the form, and in "interaction-only" mode it is usually invisible.
 */
import { SITE, TURNSTILE } from '../../config';
import Icon from '../ui/Icon.astro';

interface Props {
  variant?: 'footer' | 'card';
}
const { variant = 'card' } = Astro.props;
const enabled = SITE.features.newsletter;
const siteKey = TURNSTILE.siteKey.trim();
---

{
  enabled && (
    <div class:list={['newsletter', `newsletter-${variant}`]}>
      {variant === 'card' && (
        <div class="mb-4">
          <p class="eyebrow mb-2 text-accent!">Bản tin</p>
          <h2 class="font-display text-2xl font-extrabold tracking-tight sm:text-3xl">Bài mới, gửi thẳng vào hộp thư.</h2>
          <p class="mt-2 text-fg-muted">Mỗi tuần tối đa một email. Không spam, huỷ bất cứ lúc nào.</p>
        </div>
      )}
      {variant === 'footer' && <p class="mb-3 font-semibold">Nhận bài mới qua email — tối đa 1 lần/tuần.</p>}
      <form class="newsletter-form" data-newsletter data-source={variant} data-sitekey={siteKey || undefined} novalidate>
        <label class="sr-only" for={`nl-email-${variant}`}>
          Email của bạn
        </label>
        <div class="field" data-field>
          <Icon name="mail" size={18} class="field-icon" />
          <input
            id={`nl-email-${variant}`}
            type="email"
            name="email"
            required
            autocomplete="email"
            inputmode="email"
            autocapitalize="off"
            spellcheck="false"
            placeholder="ban@email.com"
            enterkeyhint="send"
            aria-describedby={`nl-status-${variant}`}
          />
          <button type="submit" class="btn btn-primary nl-submit shrink-0">
            <span class="nl-spinner" aria-hidden="true" />
            <span data-label>Đăng ký</span>
          </button>
        </div>
        <div class="field nl-done" data-done tabindex="-1" hidden>
          <span class="nl-done-icon" aria-hidden="true">
            <Icon name="check" size={16} strokeWidth={3} />
          </span>
          <span class="nl-done-text" data-done-text>
            Đã đăng ký!
          </span>
          <button type="button" class="nl-again" data-again>
            Dùng email khác
          </button>
        </div>
        {siteKey && <div class="nl-turnstile" data-turnstile />}
        <input type="text" name="website" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
        <p class="status" id={`nl-status-${variant}`} role="status" aria-live="polite" />
      </form>
    </div>
  )
}

<style>
  .newsletter-card {
    position: relative;
    overflow: hidden;
    padding: clamp(24px, 4vw, 40px);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border);
    background:
      radial-gradient(600px 240px at 100% 0%, color-mix(in oklab, var(--accent) 16%, transparent), transparent 70%),
      radial-gradient(400px 200px at 0% 100%, color-mix(in oklab, var(--hot) 10%, transparent), transparent 70%),
      var(--bg-elevated);
  }
  .newsletter-form {
    max-width: 560px;
  }
  .field {
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 56px;
    padding: 5px 5px 5px 14px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--bg-elevated);
    transition:
      border-color 150ms var(--ease-out),
      box-shadow 150ms var(--ease-out);
  }
  .field:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent) 18%, transparent);
  }
  .field[data-invalid] {
    border-color: var(--danger);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--danger) 14%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .field[data-invalid] {
      animation: nl-shake 360ms var(--ease-out);
    }
    .nl-done:not([hidden]) {
      animation: nl-in 360ms var(--ease-spring);
    }
  }
  @keyframes nl-shake {
    20%,
    60% {
      transform: translateX(-5px);
    }
    40%,
    80% {
      transform: translateX(5px);
    }
  }
  @keyframes nl-in {
    from {
      transform: scale(0.96);
      opacity: 0;
    }
  }
  .field :global(.field-icon) {
    flex-shrink: 0;
    color: var(--fg-subtle);
  }
  .field input {
    flex: 1;
    min-width: 0;
    height: 44px;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--fg);
    font-size: 1rem; /* >=16px: iOS won't zoom */
  }
  .field input::placeholder {
    color: var(--fg-subtle);
  }
  .field input:read-only {
    color: var(--fg-muted);
  }

  .nl-submit {
    position: relative;
  }
  .nl-spinner {
    display: none;
    width: 16px;
    height: 16px;
    border-radius: 99px;
    border: 2px solid color-mix(in oklab, var(--accent-fg) 35%, transparent);
    border-top-color: var(--accent-fg);
  }
  .newsletter-form[aria-busy='true'] .nl-spinner {
    display: inline-block;
    animation: nl-spin 700ms linear infinite;
  }
  .newsletter-form[aria-busy='true'] .nl-submit {
    cursor: progress;
    opacity: 0.92;
  }
  @keyframes nl-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .nl-done {
    gap: 10px;
    padding-left: 8px;
    border-color: color-mix(in oklab, var(--success) 45%, var(--border));
    background: color-mix(in oklab, var(--success) 8%, var(--bg-elevated));
    outline: none;
  }
  .nl-done:focus-visible {
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--success) 22%, transparent);
  }
  .nl-done-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 99px;
    background: var(--success);
    color: var(--bg-elevated);
  }
  .nl-done-text {
    flex: 1;
    min-width: 0;
    font-weight: 600;
    color: var(--fg);
    line-height: 1.3;
  }
  .nl-again {
    flex-shrink: 0;
    min-height: 44px;
    padding: 0 14px;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--fg-muted);
    transition:
      background-color 150ms var(--ease-out),
      color 150ms var(--ease-out);
  }
  .nl-again:hover {
    background: var(--bg-muted);
    color: var(--fg);
  }

  .nl-turnstile:not(:empty) {
    margin-top: 10px;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .status {
    min-height: 1.5em;
    margin-top: 8px;
    padding-left: 14px;
    font-size: 0.875rem;
    color: var(--fg-muted);
  }
  .status[data-tone='ok'] {
    color: var(--success);
  }
  .status[data-tone='error'] {
    color: var(--danger);
  }
</style>

<script>
  import { subscribe, isValidEmail } from '../../scripts/api';

  type Turnstile = {
    render: (el: HTMLElement, opts: Record<string, unknown>) => string;
    reset: (id: string) => void;
  };
  const w = window as unknown as { turnstile?: Turnstile };

  let turnstileLoad: Promise<Turnstile | null> | null = null;
  function loadTurnstile(): Promise<Turnstile | null> {
    turnstileLoad ??= new Promise((resolve) => {
      if (w.turnstile) return resolve(w.turnstile);
      const s = document.createElement('script');
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      s.async = true;
      s.onload = () => resolve(w.turnstile ?? null);
      s.onerror = () => {
        turnstileLoad = null;
        resolve(null);
      };
      document.head.append(s);
    });
    return turnstileLoad;
  }

  function wire(form: HTMLFormElement) {
    const status = form.querySelector<HTMLElement>('.status')!;
    const field = form.querySelector<HTMLElement>('[data-field]')!;
    const input = field.querySelector<HTMLInputElement>('input[name=email]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const label = button.querySelector<HTMLElement>('[data-label]')!;
    const done = form.querySelector<HTMLElement>('[data-done]')!;
    const doneText = done.querySelector<HTMLElement>('[data-done-text]')!;
    const sitekey = form.dataset.sitekey || '';
    const tsSlot = form.querySelector<HTMLElement>('[data-turnstile]');

    const say = (msg: string, tone: 'ok' | 'error' | '' = '') => {
      status.textContent = msg;
      status.dataset.tone = tone;
    };
    const invalid = (on: boolean) => {
      if (on) {
        delete field.dataset.invalid;
        void field.offsetWidth; // replay the shake
        field.dataset.invalid = '';
        input.setAttribute('aria-invalid', 'true');
      } else {
        delete field.dataset.invalid;
        input.removeAttribute('aria-invalid');
      }
    };

    // ---- Turnstile (optional) ----
    let widgetId: string | undefined;
    let token = '';
    const waiters: ((t: string) => void)[] = [];
    async function ensureWidget() {
      if (!sitekey || !tsSlot || widgetId !== undefined) return;
      const ts = await loadTurnstile();
      if (!ts || widgetId !== undefined) return;
      widgetId = ts.render(tsSlot, {
        sitekey,
        action: 'subscribe',
        appearance: 'interaction-only',
        language: 'vi',
        theme: document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light',
        callback: (t: string) => {
          token = t;
          waiters.splice(0).forEach((fn) => fn(t));
        },
        'expired-callback': () => (token = ''),
        'error-callback': () => {
          token = '';
        },
      });
    }
    function getToken(timeout = 8000): Promise<string> {
      if (!sitekey) return Promise.resolve('');
      if (token) return Promise.resolve(token);
      return new Promise((resolve) => {
        waiters.push(resolve);
        ensureWidget();
        setTimeout(() => resolve(token), timeout);
      });
    }
    if (sitekey) form.addEventListener('focusin', () => ensureWidget(), { once: true });

    input.addEventListener('input', () => {
      if (field.dataset.invalid) {
        invalid(false);
        say('');
      }
    });

    done.querySelector('[data-again]')!.addEventListener('click', () => {
      done.hidden = true;
      field.hidden = false;
      say('');
      input.focus();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (form.getAttribute('aria-busy') === 'true') return;
      const data = new FormData(form);
      const email = String(data.get('email') || '').trim();
      if (!isValidEmail(email)) {
        invalid(true);
        say(email ? 'Email chưa đúng định dạng, bạn kiểm tra lại nhé.' : 'Bạn nhập email để nhận bài mới nhé.', 'error');
        input.focus();
        return;
      }
      invalid(false);
      form.setAttribute('aria-busy', 'true');
      input.readOnly = true;
      label.textContent = 'Đang gửi…';
      say('');

      try {
        const t = await getToken();
        const res = await subscribe({
          email,
          website: String(data.get('website') || ''),
          ...(t ? { token: t } : {}),
          source: `${form.dataset.source || 'form'}:${location.pathname}`,
        });
        if (res.ok) {
          const fresh = res.status !== 'exists';
          doneText.textContent = fresh ? 'Đã đăng ký thành công!' : 'Email này đã đăng ký rồi.';
          say(
            fresh
              ? 'Hẹn gặp bạn trong hộp thư — tối đa một email mỗi tuần.'
              : 'Cảm ơn bạn vẫn luôn đồng hành cùng Nhịp Số!',
            'ok',
          );
          form.reset();
          field.hidden = true;
          done.hidden = false;
          done.focus({ preventScroll: true });
        } else {
          invalid(/email/i.test(res.error));
          say(res.error, 'error');
          input.focus();
        }
      } finally {
        form.removeAttribute('aria-busy');
        input.readOnly = false;
        label.textContent = 'Đăng ký';
        // Turnstile tokens are single-use.
        if (widgetId !== undefined) {
          token = '';
          w.turnstile?.reset(widgetId);
        }
      }
    });
  }

  document.querySelectorAll<HTMLFormElement>('form[data-newsletter]').forEach((form) => {
    if (form.dataset.wired) return;
    form.dataset.wired = '1';
    wire(form);
  });
</script>
