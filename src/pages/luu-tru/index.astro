---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/listing/PageHeader.astro';
import { CATEGORIES, getCategory } from '../../config';
import { getPosts, postUrl, getReadingTime } from '../../lib/posts';
import { yearOf, monthLabel, formatDateShort } from '../../lib/date';

const posts = await getPosts();
const years = new Map<number, typeof posts>();
for (const p of posts) {
  const y = yearOf(p.data.pubDate);
  years.set(y, [...(years.get(y) ?? []), p]);
}
---

<BaseLayout title="Lưu trữ" description="Toàn bộ bài viết trên blog Gì thế nhỉ, sắp theo thời gian.">
  <PageHeader eyebrow={`${posts.length} bài viết`} title="Lưu trữ" description="Mọi bài viết, xếp theo thời gian. Lọc nhanh theo chuyên mục bên dưới.">
    <div class="mt-6 flex flex-wrap gap-2" role="group" aria-label="Lọc chuyên mục">
      <button type="button" class="chip-btn" data-f="all" aria-pressed="true">Tất cả</button>
      {CATEGORIES.map((c) => <button type="button" class="chip-btn" data-f={c.id} aria-pressed="false" style={`--c:${c.color}`}><span class="dot" />{c.name}</button>)}
    </div>
  </PageHeader>
  <div class="container-page mt-6 max-w-4xl!">
    {
      [...years].map(([year, list]) => (
        <section class="year" aria-labelledby={`y-${year}`}>
          <h2 id={`y-${year}`} class="year-head">
            {year} <span class="text-base font-semibold text-fg-subtle">· {list.length} bài</span>
          </h2>
          <ol>
            {list.map((p, i) => {
              const m = monthLabel(p.data.pubDate);
              const showMonth = i === 0 || monthLabel(list[i - 1].data.pubDate) !== m;
              const cat = getCategory(p.data.category);
              return (
                <li data-cat={p.data.category}>
                  {showMonth && <p class="month">{m}</p>}
                  <a href={postUrl(p)} class="row">
                    <time class="row-date" datetime={p.data.pubDate.toISOString()}>{formatDateShort(p.data.pubDate).slice(0, 5)}</time>
                    <span class="dot" style={`--c:${cat.color}`} title={cat.name} />
                    <span class="row-title">{p.data.title}</span>
                    <span class="row-min">{getReadingTime(p).minutes}′</span>
                  </a>
                </li>
              );
            })}
          </ol>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .chip-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--fg-muted);
  }
  .chip-btn[aria-pressed='true'] {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }
  .dot {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 99px;
    background: var(--c);
  }
  .year-head {
    position: sticky;
    top: var(--header-h);
    z-index: 2;
    padding: 18px 0 10px;
    background: var(--bg);
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .month {
    margin: 22px 0 6px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-subtle);
  }
  .row {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 52px;
    padding: 10px 8px;
    margin-inline: -8px;
    border-radius: 12px;
    transition: background-color 150ms var(--ease-out);
  }
  .row:hover {
    background: var(--bg-subtle);
  }
  .row-date {
    width: 44px;
    flex-shrink: 0;
    font-size: 0.85rem;
    color: var(--fg-subtle);
    font-variant-numeric: tabular-nums;
  }
  .row-title {
    flex: 1;
    font-weight: 600;
    line-height: 1.4;
  }
  .row-min {
    font-size: 0.8rem;
    color: var(--fg-subtle);
  }
  li[hidden] {
    display: none;
  }
</style>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('[data-f]');
  btns.forEach((b) =>
    b.addEventListener('click', () => {
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      document.querySelectorAll<HTMLElement>('li[data-cat]').forEach((li) => (li.hidden = b.dataset.f !== 'all' && li.dataset.cat !== b.dataset.f));
      document.querySelectorAll<HTMLElement>('.year').forEach((s) => (s.hidden = !s.querySelector('li[data-cat]:not([hidden])')));
    }),
  );
</script>
