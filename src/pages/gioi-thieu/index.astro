---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/listing/PageHeader.astro';
import Newsletter from '../../components/widgets/Newsletter.astro';
import Icon from '../../components/ui/Icon.astro';
import { SITE, CATEGORIES, SOCIAL } from '../../config';
import aboutArt from '../../assets/brand/about.webp';

const author = await getEntry('authors', SITE.defaultAuthor);
const initials = (author?.data.name ?? SITE.title)
  .split(/\s+/)
  .slice(-2)
  .map((w) => w[0])
  .join('');

const description =
  '“Gì thế nhỉ” là blog tiếng Việt bắt đầu từ những câu hỏi thật về AI, công nghệ và đời sống số — rồi trả lời cho dễ hiểu, có kiểm chứng.';

/** Question → answer: how every post is made. */
const steps = [
  ['Một câu hỏi thật', 'Điều bạn — hay chính người viết — từng thắc mắc, không phải từ khoá câu lượt xem.'],
  ['Tìm hiểu và kiểm chứng', 'Đọc tài liệu gốc, thử tận tay, đối chiếu nhiều nguồn trước khi đặt bút.'],
  ['Câu trả lời dùng được', 'Giải thích gọn gàng, ví dụ cụ thể, có bước làm để bạn áp dụng ngay.'],
];
const principles = [
  ['Nói rõ điều chưa chắc', 'Chỗ nào còn tranh cãi hay chưa đủ dữ kiện, bài sẽ nói thẳng thay vì khẳng định cho xong.'],
  ['Cập nhật khi mọi thứ thay đổi', 'AI và công nghệ đổi rất nhanh — bài cũ được sửa lại và ghi ngày cập nhật khi có thông tin mới.'],
  ['Không quảng cáo', 'Không banner, không pop-up, không bài PR trá hình.'],
  ['Tôn trọng quyền riêng tư', 'Không cookie theo dõi. Thư viện đọc của bạn chỉ lưu trên trình duyệt của bạn.'],
];
const faq = [
  [
    'Mình có một thắc mắc, gửi ở đâu?',
    'Để lại bình luận dưới bài viết gần chủ đề nhất, hoặc nhắn qua các kênh bên dưới. Câu hỏi được nhiều người quan tâm sẽ được ưu tiên viết thành bài.',
  ],
  [
    'Thông tin trong bài có đáng tin không?',
    'Số liệu và nhận định quan trọng đều kèm nguồn để bạn tự kiểm chứng. Thấy chỗ nào sai hoặc đã cũ, bạn cứ báo — bài sẽ được sửa.',
  ],
  ['Tôi có thể đăng lại bài viết không?', 'Bạn có thể trích dẫn ngắn kèm liên kết về bài gốc. Muốn đăng lại toàn bài, hãy liên hệ trước.'],
  [
    'Blog có thu thập dữ liệu của tôi không?',
    'Không có cookie theo dõi. Lượt xem được đếm ẩn danh (không lưu IP). Bài đã lưu và lịch sử đọc chỉ nằm trong trình duyệt của bạn.',
  ],
  ['Làm sao để nhận bài mới?', 'Đăng ký bản tin ở cuối trang, hoặc theo dõi qua RSS bằng bất kỳ ứng dụng đọc tin nào.'],
];
---

<BaseLayout title="Giới thiệu" description={description}>
  <div class="about-head">
    <PageHeader
      eyebrow="Giới thiệu"
      title={`Chào bạn, đây là ${SITE.title}.`}
      description="Một góc nhỏ để hỏi cho ra lẽ về AI, công nghệ và đời sống số — và nhận về câu trả lời dễ hiểu, có kiểm chứng."
    >
      <Image
        src={aboutArt}
        alt="Một người ngồi bên bàn làm việc ấm cúng với sổ tay, laptop và tách cà phê; phía trên, dấu hỏi hoá thành dấu tích và bóng đèn."
        widths={[480, 720, 960, 1400]}
        sizes="(min-width: 1024px) 460px, (min-width: 640px) 440px, calc(100vw - 32px)"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="about-art"
      />
    </PageHeader>
  </div>

  <section class="container-page mt-14 max-w-4xl!" aria-labelledby="name-title">
    <h2 id="name-title" class="sec-title">Vì sao lại là “Gì thế nhỉ”?</h2>
    <p class="name-story">
      “Gì thế nhỉ?” là câu ai cũng từng buột miệng khi gặp một điều mới: một thuật ngữ AI bỗng xuất hiện khắp nơi, một cài đặt
      lạ trên điện thoại, một thói quen ai cũng nhắc tới. Mỗi bài ở đây bắt đầu từ đúng một câu hỏi như thế, rồi tìm cho ra câu
      trả lời — bằng ngôn ngữ đời thường, có nguồn để bạn tự kiểm chứng, kèm ví dụ để áp dụng ngay.
    </p>
    <ol class="qa-flow">
      {
        steps.map(([t, d], i) => (
          <li class="qa-step">
            <span class="qa-num" aria-hidden="true">
              {i + 1}
            </span>
            <span class="mt-3 block font-bold">{t}</span>
            <span class="mt-1 block text-fg-muted">{d}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container-page mt-20 grid gap-4 md:grid-cols-3" aria-label="Chuyên mục">
    {
      CATEGORIES.map((c) => (
        <a href={`/chuyen-muc/${c.id}/`} class="pillar" style={`--c:${c.color}`}>
          <span class="pillar-icon" aria-hidden="true">
            {c.icon}
          </span>
          <span class="mt-4 block font-display text-xl font-extrabold">{c.name}</span>
          <span class="mt-2 block text-fg-muted">{c.description}</span>
        </a>
      ))
    }
  </section>

  <section class="container-page mt-20 max-w-4xl!">
    <h2 class="sec-title">Cam kết với người đọc</h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      {
        principles.map(([t, d]) => (
          <div>
            <p class="flex items-center gap-2 font-bold">
              <Icon name="circle-check" size={18} class="text-success" />
              {t}
            </p>
            <p class="mt-1.5 text-fg-muted">{d}</p>
          </div>
        ))
      }
    </div>
  </section>

  {
    author && (
      <section class="container-page mt-20 max-w-4xl!">
        <div class="author-card">
          <span class="author-avatar" aria-hidden="true">
            {initials}
          </span>
          <div>
            <p class="eyebrow">Người viết</p>
            <p class="mt-1 font-display text-2xl font-extrabold">{author.data.name}</p>
            {author.data.role && <p class="text-fg-subtle">{author.data.role}</p>}
            <p class="mt-3 text-fg-muted">{author.data.bio}</p>
            <div class="mt-4 flex gap-1">
              {SOCIAL.github && (
                <a class="btn-icon" href={SOCIAL.github} aria-label="GitHub" target="_blank" rel="me noopener">
                  <Icon name="brand-github" />
                </a>
              )}
              {SOCIAL.facebook && (
                <a class="btn-icon" href={SOCIAL.facebook} aria-label="Facebook" target="_blank" rel="me noopener">
                  <Icon name="brand-facebook" />
                </a>
              )}
              {SOCIAL.email && (
                <a class="btn-icon" href={`mailto:${SOCIAL.email}`} aria-label="Email">
                  <Icon name="mail" />
                </a>
              )}
              <a class="btn-icon" href="/rss.xml" aria-label="RSS">
                <Icon name="rss" />
              </a>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section class="container-page mt-20 max-w-4xl!">
    <h2 class="sec-title">Câu hỏi thường gặp</h2>
    <div class="mt-6 grid gap-3">
      {
        faq.map(([q, a]) => (
          <details class="faq">
            <summary>
              {q}
              <Icon name="chevron-down" size={18} class="faq-chev" />
            </summary>
            <p>{a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="container-page mt-20">
    <Newsletter variant="card" />
  </section>
</BaseLayout>

<style>
  /*
   * Header art: below the description on phones/tablets, beside the header text on lg+. It is the LCP element at
   * 390px and 1440px alike (measured), so it loads eagerly with high priority rather than lazily.
   */
  .about-art {
    display: block;
    width: 100%;
    max-width: 440px;
    height: auto;
    margin-top: 24px;
  }
  @media (min-width: 1024px) {
    /*
     * PageHeader renders eyebrow, title, description, then this slot. Text goes in column 1 (rows 2–4), the art
     * spans every row of column 2, and the two 1fr rows split any spare height so the text sits centred beside it.
     */
    .about-head :global(.page-header > .container-page) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 460px);
      grid-template-rows: 1fr auto auto auto 1fr;
      column-gap: 56px;
    }
    .about-head :global(.page-header .eyebrow) {
      grid-area: 2 / 1;
    }
    .about-head :global(.page-header .ph-title) {
      grid-area: 3 / 1;
    }
    .about-head :global(.page-header .ph-desc) {
      grid-area: 4 / 1;
    }
    .about-head .about-art {
      grid-area: 1 / 2 / -1 / 3;
      align-self: center;
      max-width: none;
      margin: 0;
    }
  }
  .pillar {
    display: block;
    padding: 26px;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border);
    background:
      radial-gradient(360px 140px at 0% 0%, color-mix(in oklab, var(--c) 12%, transparent), transparent 70%),
      var(--bg-elevated);
    transition:
      transform 200ms var(--ease-out),
      box-shadow 200ms var(--ease-out);
  }
  .pillar:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .pillar-icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 16px;
    color: var(--c);
    background: color-mix(in oklab, var(--c) 14%, transparent);
    font-size: 1.5rem;
  }
  .sec-title {
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .name-story {
    margin-top: 14px;
    max-width: 68ch;
    font-size: 1.075rem;
    line-height: 1.75;
    color: var(--fg-muted);
  }
  .qa-flow {
    display: grid;
    gap: 12px;
    margin-top: 28px;
    list-style: none;
    padding: 0;
  }
  @media (min-width: 640px) {
    .qa-flow {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .qa-step {
    position: relative;
    padding: 20px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--bg-elevated);
  }
  .qa-num {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    color: #fff;
    font-weight: 800;
    background: linear-gradient(135deg, #6d5dfc, #f0562e);
  }
  /* "→" between the steps on wide screens: question leads to answer. */
  @media (min-width: 640px) {
    .qa-step:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 50%;
      right: -12px;
      width: 12px;
      height: 2px;
      background: var(--border-strong);
    }
  }
  .author-card {
    display: flex;
    gap: 22px;
    align-items: flex-start;
    padding: 28px;
    border-radius: var(--radius-xl);
    background: var(--bg-subtle);
  }
  .author-avatar {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 76px;
    height: 76px;
    border-radius: 99px;
    color: #fff;
    font-weight: 800;
    font-size: 1.5rem;
    background: linear-gradient(135deg, #6d5dfc, #f0562e);
  }
  .faq {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
  }
  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 56px;
    padding: 0 18px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq :global(.faq-chev) {
    flex-shrink: 0;
    color: var(--fg-subtle);
    transition: transform 200ms var(--ease-out);
  }
  .faq[open] :global(.faq-chev) {
    transform: rotate(180deg);
  }
  .faq p {
    padding: 0 18px 18px;
    color: var(--fg-muted);
  }
</style>
