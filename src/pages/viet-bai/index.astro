---
/**
 * /viet-bai/ — the writing studio: write, preview and publish posts from the browser.
 *
 * It is a static page like any other; all the work happens in src/studio/app.ts. Nothing here is
 * secret: without a GitHub token that can push to the blog repo the page can do nothing.
 * Saving = one commit to GitHub → Cloudflare rebuilds the site (about 1–2 minutes).
 */
import Head from '../../components/layout/Head.astro';
import Icon from '../../components/ui/Icon.astro';
import Logo from '../../components/layout/Logo.astro';
import Toaster from '../../components/ui/Toaster.astro';
import '../../styles/prose.css';
import { CATEGORIES, SITE, STUDIO } from '../../config';
---

<!doctype html>
<html lang={SITE.lang} data-theme="light">
  <head>
    <Head title="Viết bài" description="Trang soạn và đăng bài của chủ blog." noindex />
  </head>
  <body class="studio" data-view="boot" data-repo={STUDIO.repo} data-branch={STUDIO.branch}>
    <!-- ───────────────────────────── Top bar ───────────────────────────── -->
    <header class="st-top">
      <Logo class="st-brand" />
      <span class="st-brand-tag">Viết bài</span>
      <span class="st-top-space"></span>
      <a class="st-top-link" href={`https://github.com/${STUDIO.repo}`} target="_blank" rel="noopener noreferrer" data-when="auth">
        <Icon name="brand-github" size={16} /> <span>{STUDIO.repo}</span>
      </a>
      <button type="button" class="btn-icon" data-theme-toggle aria-label="Đổi giao diện sáng/tối" title="Đổi giao diện sáng/tối">
        <span class="st-sun"><Icon name="sun" /></span>
        <span class="st-moon"><Icon name="moon" /></span>
      </button>
      <button type="button" class="btn-icon" data-action="logout" data-when="auth" aria-label="Đăng xuất" title="Đăng xuất">
        <Icon name="log-out" />
      </button>
    </header>

    <!-- ───────────────────────────── Boot ───────────────────────────── -->
    <main class="st-view st-boot" data-view-name="boot">
      <p class="st-muted" role="status">Đang mở trang viết bài…</p>
      <noscript><p>Trang viết bài cần bật JavaScript.</p></noscript>
    </main>

    <!-- ───────────────────────────── Login ───────────────────────────── -->
    <main class="st-view st-login" data-view-name="login">
      <form class="st-card st-login-card" data-form="login" novalidate>
        <p class="eyebrow">Dành cho chủ blog</p>
        <h1 class="st-h1">Đăng nhập để viết bài</h1>
        <p class="st-muted">
          Dán <strong>token GitHub</strong> của bạn. Trang dùng token này để lưu bài thẳng vào repo
          <code>{STUDIO.repo}</code>; mỗi lần lưu, blog tự cập nhật sau 1–2 phút.
        </p>
        <label class="st-field">
          <span class="st-label">Token GitHub</span>
          <input class="st-input" type="password" name="token" autocomplete="off" spellcheck="false" placeholder="github_pat_…" required />
        </label>
        <label class="st-check">
          <input type="checkbox" name="remember" />
          <span>Ghi nhớ trên thiết bị này <small class="st-muted">(chỉ bật trên máy của riêng bạn)</small></span>
        </label>
        <p class="st-error" data-login-error role="alert" hidden></p>
        <button class="btn btn-primary st-wide" type="submit">Đăng nhập</button>
        <details class="st-help">
          <summary>Chưa có token? Tạo trong 1 phút</summary>
          <ol>
            <li>
              Mở <a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener noreferrer">GitHub → Fine-grained tokens → Generate new token</a>.
            </li>
            <li><strong>Repository access</strong>: chọn <em>Only select repositories</em> → <code>{STUDIO.repo}</code>.</li>
            <li><strong>Permissions → Repository → Contents</strong>: <em>Read and write</em>. Không cần quyền nào khác.</li>
            <li>Đặt thời hạn (ví dụ 90 ngày), bấm <em>Generate token</em> rồi dán vào ô trên.</li>
          </ol>
          <p class="st-muted">Token chỉ nằm trong trình duyệt của bạn và chỉ được gửi tới GitHub (và tới trợ lý AI của chính blog này để xác nhận bạn là chủ blog).</p>
        </details>
      </form>
    </main>

    <!-- ───────────────────────────── Post list ───────────────────────────── -->
    <main class="st-view st-list" data-view-name="list">
      <div class="st-list-head">
        <div>
          <h1 class="st-h1">Bài viết</h1>
          <p class="st-muted" data-list-count>&nbsp;</p>
        </div>
        <button type="button" class="btn btn-primary" data-action="new"><Icon name="plus" size={18} /> Bài mới</button>
      </div>
      <div class="st-list-tools">
        <div class="st-seg" role="tablist" aria-label="Lọc bài viết">
          <button type="button" role="tab" data-filter="all" aria-selected="true">Tất cả</button>
          <button type="button" role="tab" data-filter="draft" aria-selected="false">Nháp</button>
          <button type="button" role="tab" data-filter="scheduled" aria-selected="false">Hẹn giờ</button>
          <button type="button" role="tab" data-filter="published" aria-selected="false">Đã đăng</button>
        </div>
        <label class="st-search">
          <Icon name="search" size={16} />
          <input type="search" data-list-search placeholder="Tìm theo tiêu đề…" aria-label="Tìm bài viết" />
        </label>
      </div>
      <div class="st-local" data-local-new hidden>
        <Icon name="history" size={18} />
        <span>Bạn có một bài mới đang viết dở trên máy này: <strong data-local-new-title></strong></span>
        <button type="button" class="btn btn-ghost st-btn-sm" data-action="resume-new">Viết tiếp</button>
        <button type="button" class="st-link-btn" data-action="discard-new">Bỏ</button>
      </div>
      <ul class="st-rows" data-rows aria-live="polite"></ul>
      <p class="st-empty" data-list-empty hidden>Chưa có bài nào khớp. Bấm <strong>Bài mới</strong> để bắt đầu viết.</p>
    </main>

    <!-- ───────────────────────────── Editor ───────────────────────────── -->
    <div class="st-view st-editor" data-view-name="editor" data-mode="write">
      <div class="st-edbar">
        <button type="button" class="btn-icon" data-action="back" aria-label="Về danh sách bài" title="Về danh sách bài"><Icon name="arrow-left" /></button>
        <span class="st-status" data-status data-state="saved" role="status">
          <span class="st-status-dot" aria-hidden="true"></span><span data-status-text>Chưa thay đổi</span>
        </span>
        <span class="st-top-space"></span>
        <div class="st-seg" role="tablist" aria-label="Chế độ">
          <button type="button" role="tab" data-mode-btn="write" aria-selected="true"><Icon name="pen" size={16} /> <span>Soạn</span></button>
          <button type="button" role="tab" data-mode-btn="preview" aria-selected="false"><Icon name="eye" size={16} /> <span>Xem trước</span></button>
        </div>
        <button type="button" class="btn btn-ghost st-btn-sm st-ai-btn" data-action="toggle-ai" aria-expanded="false" title="Trợ lý AI">
          <Icon name="sparkles" size={16} /> <span>AI</span>
        </button>
        <button type="button" class="btn btn-ghost st-btn-sm" data-action="toggle-settings" aria-expanded="false" title="Thiết lập bài">
          <Icon name="sliders" size={16} /> <span>Thiết lập</span>
        </button>
        <button type="button" class="btn btn-ghost st-btn-sm" data-action="save-draft"><span data-draft-label>Lưu nháp</span></button>
        <button type="button" class="btn btn-primary st-btn-sm" data-action="publish"><Icon name="send" size={16} /> <span data-publish-label>Đăng bài</span></button>
      </div>

      <div class="st-work">
        <!-- Write -->
        <section class="st-paper" data-pane="write" aria-label="Soạn bài">
          <textarea class="st-title" data-f="title" rows="1" placeholder="Tiêu đề bài viết" aria-label="Tiêu đề" maxlength="200"></textarea>
          <div class="st-desc-wrap">
            <textarea class="st-desc" data-f="description" rows="2" placeholder="Mô tả ngắn 1–2 câu: hiện dưới tiêu đề, trên Google và khi chia sẻ link." aria-label="Mô tả ngắn"></textarea>
            <span class="st-counter" data-desc-count>0/300</span>
          </div>
          <div class="st-crepe" data-editor></div>
          <p class="st-foot" data-word-count></p>
        </section>

        <!-- Preview -->
        <section class="st-preview" data-pane="preview" aria-label="Xem trước" hidden>
          <div class="st-preview-tools">
            <span class="st-muted">Bài sẽ hiện trên blog gần như thế này.</span>
            <div class="st-seg" role="tablist" aria-label="Kích thước màn hình">
              <button type="button" role="tab" data-device="desktop" aria-selected="true"><Icon name="monitor" size={16} /> <span>Máy tính</span></button>
              <button type="button" role="tab" data-device="mobile" aria-selected="false"><Icon name="smartphone" size={16} /> <span>Điện thoại</span></button>
            </div>
          </div>
          <div class="st-frame" data-frame data-device="desktop">
            <article class="st-article" data-preview></article>
          </div>
        </section>

        <!-- Settings drawer -->
        <aside class="st-drawer" data-drawer="settings" aria-label="Thiết lập bài" hidden>
          <div class="st-drawer-head">
            <h2>Thiết lập bài</h2>
            <button type="button" class="btn-icon" data-action="close-drawer" aria-label="Đóng"><Icon name="x" /></button>
          </div>
          <div class="st-drawer-body">
            <label class="st-field" data-slug-field>
              <span class="st-label">Đường dẫn</span>
              <input class="st-input" data-f="slug" spellcheck="false" autocomplete="off" />
              <span class="st-hint" data-slug-hint>/bai-viet/…/</span>
            </label>
            <label class="st-field">
              <span class="st-label">Chuyên mục</span>
              <select class="st-input" data-f="category">
                {CATEGORIES.map((c) => <option value={c.id}>{c.name}</option>)}
              </select>
            </label>
            <label class="st-field">
              <span class="st-label">Thẻ</span>
              <input class="st-input" data-f="tags" placeholder="ChatGPT, Năng suất" autocomplete="off" />
              <span class="st-hint">Cách nhau bằng dấu phẩy.</span>
            </label>
            <div class="st-two">
              <label class="st-field">
                <span class="st-label">Ngày đăng</span>
                <input class="st-input" type="date" data-f="pubDate" />
              </label>
              <label class="st-field">
                <span class="st-label">Ngày cập nhật</span>
                <input class="st-input" type="date" data-f="updatedDate" />
              </label>
            </div>
            <p class="st-hint" data-date-hint></p>

            <div class="st-field">
              <span class="st-label">Ảnh bìa</span>
              <div class="st-cover" data-cover>
                <img data-cover-img alt="" hidden />
                <p class="st-hint" data-cover-empty>Chưa có ảnh bìa — blog sẽ dùng ảnh tự sinh theo chuyên mục.</p>
              </div>
              <div class="st-row">
                <label class="btn btn-ghost st-btn-sm">
                  <Icon name="image" size={16} /> Chọn ảnh
                  <input type="file" accept="image/jpeg,image/png,image/webp,image/avif" data-cover-input hidden />
                </label>
                <button type="button" class="st-link-btn" data-action="remove-cover" hidden>Gỡ ảnh bìa</button>
              </div>
              <input class="st-input" data-f="coverAlt" placeholder="Mô tả ảnh bìa (cho trình đọc màn hình)" autocomplete="off" />
            </div>

            <label class="st-field">
              <span class="st-label">Tóm tắt nhanh</span>
              <textarea class="st-input" data-f="summary" rows="3" placeholder="1–3 câu hiện ở đầu bài cho người đọc vội."></textarea>
            </label>
            <label class="st-field">
              <span class="st-label">Ý chính rút ra</span>
              <textarea class="st-input" data-f="takeaways" rows="4" placeholder="Mỗi dòng một ý (3–5 ý)."></textarea>
            </label>
            <div class="st-two">
              <label class="st-field">
                <span class="st-label">Series</span>
                <input class="st-input" data-f="series" placeholder="Tên series" autocomplete="off" />
              </label>
              <label class="st-field">
                <span class="st-label">Phần số</span>
                <input class="st-input" type="number" min="1" step="1" data-f="seriesOrder" />
              </label>
            </div>
            <label class="st-check"><input type="checkbox" data-f="featured" /> <span>Ghim nổi bật trên trang chủ</span></label>
            <label class="st-check"><input type="checkbox" data-f="comments" /> <span>Cho phép bình luận</span></label>
            <button type="button" class="st-danger" data-action="delete" hidden><Icon name="trash" size={16} /> Xoá bài viết này</button>
          </div>
        </aside>

        <!-- AI drawer -->
        <aside class="st-drawer" data-drawer="ai" aria-label="Trợ lý AI" hidden>
          <div class="st-drawer-head">
            <h2><Icon name="sparkles" size={18} /> Trợ lý AI</h2>
            <button type="button" class="btn-icon" data-action="close-drawer" aria-label="Đóng"><Icon name="x" /></button>
          </div>
          <div class="st-drawer-body" data-ai-off hidden>
            <p>Trợ lý AI chưa được bật trên máy chủ.</p>
            <p class="st-muted">Để bật, tạo khoá tại platform.deepseek.com rồi chạy lệnh sau trong thư mục dự án và dán khoá vào:</p>
            <pre class="st-pre">npx wrangler secret put DEEPSEEK_API_KEY</pre>
            <p class="st-muted">Khoá nằm an toàn trên Cloudflare, không xuất hiện trong mã nguồn hay trình duyệt.</p>
          </div>
          <div class="st-drawer-body" data-ai-on>
            <div class="st-seg st-seg-full" role="tablist" aria-label="Việc cần AI giúp">
              <button type="button" role="tab" data-ai-tab="draft" aria-selected="true">Viết nháp</button>
              <button type="button" role="tab" data-ai-tab="rewrite" aria-selected="false">Sửa đoạn</button>
              <button type="button" role="tab" data-ai-tab="meta" aria-selected="false">Gợi ý</button>
            </div>

            <div data-ai-panel="draft">
              <label class="st-field">
                <span class="st-label">Chủ đề</span>
                <input class="st-input" data-ai="topic" placeholder="Ví dụ: Passkey là gì và vì sao nên dùng" autocomplete="off" />
              </label>
              <label class="st-field">
                <span class="st-label">Ý tưởng, ghi chú của bạn</span>
                <textarea class="st-input" data-ai="notes" rows="5" placeholder="Vài gạch đầu dòng: bạn muốn nói gì, cho ai đọc, ví dụ nào muốn dùng…"></textarea>
              </label>
              <label class="st-field">
                <span class="st-label">Dàn ý <small class="st-muted">(tuỳ chọn — sửa tuỳ ý trước khi viết)</small></span>
                <textarea class="st-input" data-ai="outline" rows="6" placeholder="Bấm “Lập dàn ý” để AI đề xuất, hoặc tự gõ."></textarea>
              </label>
              <label class="st-field">
                <span class="st-label">Độ dài</span>
                <select class="st-input" data-ai="length">
                  <option value="short">Ngắn (500–700 từ)</option>
                  <option value="medium" selected>Vừa (900–1.200 từ)</option>
                  <option value="long">Dài (1.500–2.000 từ)</option>
                </select>
              </label>
              <div class="st-row">
                <button type="button" class="btn btn-ghost st-btn-sm" data-action="ai-outline">Lập dàn ý</button>
                <button type="button" class="btn btn-primary st-btn-sm" data-action="ai-draft"><Icon name="sparkles" size={16} /> Viết bản nháp</button>
              </div>
            </div>

            <div data-ai-panel="rewrite" hidden>
              <p class="st-hint">Bôi đen một đoạn trong bài rồi chọn việc cần làm.</p>
              <blockquote class="st-quote" data-ai-selection data-empty="true">Chưa chọn đoạn nào.</blockquote>
              <div class="st-chips" role="group" aria-label="Cách sửa">
                <button type="button" class="chip" data-ai-mode="improve">Mượt hơn</button>
                <button type="button" class="chip" data-ai-mode="shorter">Rút gọn</button>
                <button type="button" class="chip" data-ai-mode="longer">Mở rộng</button>
                <button type="button" class="chip" data-ai-mode="simpler">Dễ hiểu hơn</button>
                <button type="button" class="chip" data-ai-mode="fix">Sửa chính tả</button>
              </div>
              <form class="st-row" data-form="ai-custom">
                <input class="st-input" data-ai="instruction" placeholder="Hoặc yêu cầu riêng: “thêm một ví dụ về…”" autocomplete="off" />
                <button type="submit" class="btn btn-ghost st-btn-sm">Chạy</button>
              </form>
            </div>

            <div data-ai-panel="meta" hidden>
              <p class="st-hint">AI đọc bài hiện tại rồi đề xuất tiêu đề, mô tả, thẻ, tóm tắt và ý chính. Bạn chọn cái nào dùng.</p>
              <button type="button" class="btn btn-primary st-btn-sm" data-action="ai-meta"><Icon name="sparkles" size={16} /> Gợi ý từ nội dung bài</button>
              <div class="st-meta-out" data-ai-meta-out></div>
            </div>

            <div class="st-ai-out" data-ai-out hidden>
              <div class="st-ai-out-head">
                <span class="st-label" data-ai-out-title>Kết quả</span>
                <button type="button" class="st-link-btn" data-action="ai-stop" hidden>Dừng</button>
              </div>
              <div class="st-ai-text prose" data-ai-text></div>
              <div class="st-row" data-ai-actions hidden></div>
            </div>
            <p class="st-error" data-ai-error role="alert" hidden></p>
            <p class="st-hint st-ai-note">AI có thể sai. Hãy đọc lại và kiểm chứng số liệu, đường dẫn trước khi đăng.</p>
          </div>
        </aside>
      </div>
    </div>

    <!-- ───────────────────────────── Confirm dialog ───────────────────────────── -->
    <dialog class="st-dialog" data-dialog>
      <form method="dialog">
        <h2 data-dialog-title></h2>
        <p data-dialog-text></p>
        <div class="st-row st-row-end">
          <button class="btn btn-ghost st-btn-sm" value="cancel" data-dialog-cancel>Huỷ</button>
          <button class="btn btn-primary st-btn-sm" value="ok" data-dialog-ok>Đồng ý</button>
        </div>
      </form>
    </dialog>

    <!-- Icons the list rows clone at runtime (icons are build-time SVG; there is no JS icon set). -->
    <template data-icon="external-link"><Icon name="external-link" size={18} /></template>

    <Toaster />
  </body>
</html>

<script>
  import '../../studio/app';
</script>

<style is:global>
  /* The studio builds most of its DOM in JS, so its styles are global but namespaced under .studio. */
  .studio {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    background: var(--bg-subtle);
  }
  .studio [hidden] {
    display: none !important;
  }
  .studio .st-view {
    display: none;
  }
  .studio[data-view='boot'] [data-view-name='boot'],
  .studio[data-view='login'] [data-view-name='login'],
  .studio[data-view='list'] [data-view-name='list'] {
    display: block;
  }
  .studio[data-view='editor'] [data-view-name='editor'] {
    display: flex;
  }
  .studio:not([data-auth]) [data-when='auth'] {
    display: none;
  }
  .st-muted {
    color: var(--fg-muted);
  }
  .st-h1 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  /* Top bar */
  .st-top {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 56px;
    padding: 0 12px 0 16px;
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border);
  }
  .studio[data-view='editor'] .st-top {
    display: none; /* the editor has its own bar: every pixel goes to the writing */
  }
  .st-brand {
    display: inline-flex;
    align-items: center;
  }
  .st-brand-tag {
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .st-top-space {
    flex: 1;
  }
  .st-top-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: 999px;
    color: var(--fg-muted);
    font-size: 0.8125rem;
  }
  .st-top-link:hover {
    background: var(--bg-muted);
    color: var(--fg);
  }
  [data-theme='dark'] .st-sun,
  [data-theme='light'] .st-moon {
    display: none;
  }

  /* Boot + login */
  .st-boot {
    padding: 96px 16px;
    text-align: center;
  }
  .st-login {
    padding: 40px 16px 64px;
  }
  .st-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .st-login-card {
    max-width: 480px;
    margin: 0 auto;
    padding: 28px 24px;
    display: grid;
    gap: 16px;
  }
  .st-login-card code,
  .st-help code {
    padding: 1px 6px;
    border-radius: 6px;
