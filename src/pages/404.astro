---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/post/PostCard.astro';
import Icon from '../components/ui/Icon.astro';
import { CATEGORIES } from '../config';
import { getPosts } from '../lib/posts';
import notFoundArt from '../assets/brand/not-found.webp';
const latest = (await getPosts()).slice(0, 3);
---

<BaseLayout title="Không tìm thấy trang" noindex>
  <section class="container-page pt-8 text-center sm:pt-12">
    <Image
      src={notFoundArt}
      alt="Một người cầm bản đồ, gãi đầu bối rối trên con đường vắng cạnh cột biển chỉ đường, phía trên là một dấu hỏi lớn."
      widths={[320, 480, 640, 900]}
      sizes="(min-width: 640px) 320px, 240px"
      loading="lazy"
      decoding="async"
      class="nf-art"
    />
    <p class="eyebrow mt-4">Lỗi 404</p>
    <h1 class="mt-3 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Ủa, trang này đi đâu rồi nhỉ?</h1>
    <p class="mx-auto mt-4 max-w-lg text-lg text-fg-muted">
      Có thể đường dẫn đã đổi, hoặc trang không còn nữa. Nhưng thắc mắc của bạn vẫn đáng một câu trả lời — thử tìm kiếm, hoặc
      chọn một lối đi bên dưới nhé.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <button type="button" class="btn btn-primary" data-open-search><Icon name="search" size={18} />Tìm bài viết</button>
      <a href="/" class="btn btn-ghost"><Icon name="home" size={18} />Về trang chủ</a>
      <a href="/ngau-nhien/" class="btn btn-ghost"><Icon name="dice" size={18} />Đọc ngẫu nhiên</a>
    </div>
    <div class="mt-6 flex flex-wrap justify-center gap-2">
      {
        CATEGORIES.map((c) => (
          <a href={`/chuyen-muc/${c.id}/`} class="chip" style={`--chip-color:${c.color}`}>
            {c.icon} {c.name}
          </a>
        ))
      }
    </div>
  </section>
  {
    latest.length > 0 && (
      <section class="container-page mt-20">
        <h2 class="mb-8 font-display text-2xl font-extrabold tracking-tight">Bài mới để bạn đọc</h2>
        <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
          {latest.map((p) => (
            <PostCard post={p} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .nf-art {
    display: block;
    width: 240px;
    height: auto;
    margin-inline: auto;
  }
  @media (min-width: 640px) {
    .nf-art {
      width: 320px;
    }
  }
</style>
