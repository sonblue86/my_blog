{
  "name": "nhip-so-blog",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Blog tiếng Việt về AI, công nghệ và đời sống — Astro + Cloudflare",
  "scripts": {
    "dev": "astro dev",
    "dev:api": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && wrangler dev --port 8787",
    "dev:all": "concurrently -k -n astro,api \"npm:dev\" \"npm:dev:api\"",
    "build": "astro build && pagefind --site dist",
    "preview": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "check": "astro check",
    "test": "vitest run",
    "new": "node scripts/new-post.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "db:migrate:local": "wrangler d1 migrations apply blog-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply blog-db --remote",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.7",
    "astro-expressive-code": "^0.44.3",
    "lucide-static": "^1.70.0",
    "pagefind": "^1.6.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "simple-icons": "^16.37.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261109.1",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.7",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
